rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Yossi's Google accounts are the only admins
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['yossiazulaysales@gmail.com']}

    function str(v, max) { return v is string && v.size() <= max; }

    // Website inquiry form: anyone may CREATE one lead, nobody but admins may read/change
    match /leads/{leadId} {
      allow create: if request.resource.data.keys().hasOnly(
                        ['lang','etype','date','loc','name','phone','email','heard','names','notes','status','source','createdAt'])
                    && request.resource.data.status == 'new'
                    && request.resource.data.source == 'site'
                    && request.resource.data.createdAt == request.time
                    && str(request.resource.data.phone, 40) && request.resource.data.phone.size() > 0
                    && str(request.resource.data.email, 120)
                    && str(request.resource.data.date, 20)
                    && str(request.resource.data.loc, 200)
                    && str(request.resource.data.name, 120)
                    && str(request.resource.data.heard, 200)
                    && str(request.resource.data.names, 200)
                    && str(request.resource.data.notes, 2000)
                    && str(request.resource.data.etype, 30)
                    && str(request.resource.data.lang, 5);
      allow read, update, delete: if isAdmin();
    }

    // Client personal area: whoever holds the secret link can read that one
    // document and may only write their own answers (resp + respAt).
    match /portal/{token} {
      allow get: if true;
      allow list, create, delete: if isAdmin();
      allow update: if isAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resp', 'respAt'])
        && request.resource.data.respAt == request.time
        && request.resource.data.resp.get('sigImg', '').size() < 300000
      );
    }

    // Everything else: admins only
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
